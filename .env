PORT=3000
PULL_ZONE_BASE=https://vz-e5c3a5b4-96b.b-cdn.net
BUNNY_CDN_TOKEN_KEY=5b791994-e41d-4983-aadc-c8623bbfdad0

# Security knobs
BIND_IP=false            # true in prod to bind token to client IP (disable on localhost/mobile)
ALLOWED_COUNTRIES=       # e.g. EG,SA  (comma-separated)  leave empty to disable
SPEED_LIMIT_KBPS=        # e.g. 1500  (kB/s)              leave empty to disable
TOKEN_TTL_SECONDS=900    # 15 minutes (keep short)

# Anti-sharing policy
MAX_CONCURRENT=1         # allow 1 active playback per account
MAX_DEVICES=2            # allow 2 registered devices per account
HEARTBEAT_SECONDS=60     # client sends a ping every 60s
GRACE_SECONDS=120        # session stays “active” this long after last heartbeat

# Sequential-sharing deterrents
COOLDOWN_SECONDS=300        # require 5 min between handoffs across different device/IP
SESSION_STARTS_PER_DAY=20   # daily session start budget per user
REQUIRE_HARD_TAKEOVER=true  # 409 unless client explicitly ends prior active session

