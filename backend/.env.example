# Bunny Stream Configuration
# Get these from Stream → Your Library → Settings → Security
PULL_ZONE_BASE=https://vz-XXXX.b-cdn.net
BUNNY_CDN_TOKEN_KEY=your-advanced-cdn-token-key-here

# Token Configuration
TOKEN_TTL_SECONDS=900                    # Default 15 minutes
BIND_IP=false                           # Set to true in production for IP binding
ALLOWED_COUNTRIES=                      # Optional: e.g. EG,SA (comma-separated)
SPEED_LIMIT_KBPS=                      # Optional: e.g. 1500 (bandwidth limit in kB/s)

# Anti-Sharing Configuration
MAX_CONCURRENT=1                        # Maximum concurrent sessions per user
MAX_DEVICES=2                          # Maximum registered devices per user
HEARTBEAT_SECONDS=60                   # Heartbeat interval in seconds
GRACE_SECONDS=120                      # Grace period before session expires
COOLDOWN_SECONDS=300                   # Cooldown between device/IP switches (5 minutes)
SESSION_STARTS_PER_DAY=20             # Daily session start limit per user
REQUIRE_HARD_TAKEOVER=true            # Require explicit confirmation for session takeover

# Server Configuration
PORT=3001                              # Server port
NODE_ENV=development                   # development | production